{
  "name": "aurah360-clinicos",
  "version": "0.1.0",
  "private": true,
  "description": "Aurah 360 ClinicOS — custom clinic software (not SaaS)",
  "scripts": {
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "prod:up": "docker compose -f docker/docker-compose.prod.yml --env-file backend/.env up -d --build",
    "prod:down": "docker compose -f docker/docker-compose.prod.yml down",
    "smoke:regression": "npm --prefix backend run smoke:regression",
    "smoke:module19": "npm --prefix backend run smoke:module19"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
