node_modules/
dist/
build/
coverage/
.env
.env.local
.env.*.local
*.log
logs/
# A gitignore pattern that contains a slash is anchored to THIS directory, so the original
# `uploads/*` only ever matched a top-level `/uploads` — `backend/uploads/` was tracked, and 36
# directories of real uploaded patient documents and clinical photos were staged for commit.
# `**/` matches at any depth, which is what was meant.
**/uploads/*
!**/uploads/.gitkeep
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.turbo/
# Throwaway diagnostic scripts. These are written next to the source (rather than in a temp dir)
# so their relative imports resolve, and they were being swept into commits by `git add -A`.
*.tmp.mjs
*-tmp.mjs
probe-tmp.mjs
backend/.env.atlas-backup-*
backend/.env
