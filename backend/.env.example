# Application
NODE_ENV=development
APP_NAME=Aurah360ClinicOS
APP_URL=http://localhost:5000
PORT=5000
API_PREFIX=/api/v1
TZ=Asia/Kolkata

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/aurah360_clinicos

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Patient portal JWT (optional — defaults derive from staff secrets)
# PATIENT_JWT_ACCESS_SECRET=
# PATIENT_JWT_REFRESH_SECRET=
# PATIENT_JWT_ACCESS_EXPIRES_IN=30m
# PATIENT_JWT_REFRESH_EXPIRES_IN=30d
# SEED_PATIENT_PASSWORD=Patient@12345

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Storage: local | s3 | azure | gcs (cloud adapters are placeholders)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# API docs (set false in locked-down production)
ENABLE_SWAGGER=true

# Clinic (single-client — Aurah 360)
CLINIC_NAME=Aurah 360
CLINIC_DEFAULT_TIMEZONE=Asia/Kolkata
CLINIC_DEFAULT_LOCALE=en

# --- SMS (MOCK | HTTP_DLT | BULKSENDERS). Production refuses to start on MOCK. ---
SMS_PROVIDER=MOCK
SMS_BULKSENDERS_BASE_URL=https://login.bulksenders.in/app/smsapi/index.php
SMS_BULKSENDERS_API_KEY=
SMS_BULKSENDERS_CAMPAIGN=
SMS_BULKSENDERS_ROUTE_ID=
SMS_BULKSENDERS_SENDER_ID=
SMS_BULKSENDERS_TEMPLATE_ID=
SMS_BULKSENDERS_PE_ID=
