{
  "type": "json_schema",
  "name": "clinical_precheck",
  "description": "Structured pre-consultation analysis of reception intake (symptoms + optional photos) for the doctor's one-glance panel.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "possible_conditions",
      "questions_to_ask",
      "suggested_reports",
      "medicine_suggestions",
      "red_flags",
      "based_on_photos",
      "confidence_note"
    ],
    "properties": {
      "summary": { "type": "string" },
      "possible_conditions": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "likelihood", "reasoning"],
          "properties": {
            "name": { "type": "string" },
            "likelihood": { "type": "integer", "minimum": 1, "maximum": 100 },
            "reasoning": { "type": "string" }
          }
        }
      },
      "questions_to_ask": { "type": "array", "maxItems": 6, "items": { "type": "string" } },
      "suggested_reports": {
        "type": "array",
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["test", "reason"],
          "properties": {
            "test": { "type": "string" },
            "reason": { "type": "string" }
          }
        }
      },
      "medicine_suggestions": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "active_ingredients", "form", "caution"],
          "properties": {
            "category": { "type": "string" },
            "active_ingredients": { "type": "array", "items": { "type": "string" } },
            "form": { "type": "string" },
            "caution": { "type": "string" }
          }
        }
      },
      "red_flags": { "type": "array", "items": { "type": "string" } },
      "based_on_photos": { "type": "boolean" },
      "confidence_note": { "type": "string" }
    }
  }
}
